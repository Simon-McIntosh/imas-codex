  "ranked_changes": [
    {
      "change": "drop the claim term, inverted and flat checks",
      "mechanism": "Removes all three defects at once: the near-chance claim term, the two inverted checks and the constant check. This is the largest calibration-only gain available with no new judge call.",
      "calibration_auc": 0.6571662808641975,
      "lower": 0.575238642281174,
      "upper": 0.7431337685173383,
      "needs_new_calls": false,
      "cost_usd": 0.0,
      "cost_note": "none"
    },
    {
      "change": "drop the near-chance claim term, renormalise",
      "mechanism": "The claim channel carries weight 0.2 in the aggregate but scores near chance alone, so it adds noise rather than signal; renormalising the dimension and check weights over the remaining 0.8 leaves only the components that separate.",
      "calibration_auc": 0.6454957561728395,
      "lower": 0.5643622340012426,
      "upper": 0.734762000806777,
      "needs_new_calls": false,
      "cost_usd": 0.0,
      "cost_note": "none"
    },
    {
      "change": "drop the inverted checks",
      "mechanism": "Two checks score below chance, so their higher values point at rejection rather than acceptance; removing them from the check mean stops them from cancelling the checks that do carry signal.",
      "calibration_auc": 0.6217689043209876,
      "lower": 0.5399006666135698,
      "upper": 0.7171398869637164,
      "needs_new_calls": false,
      "cost_usd": 0.0,
      "cost_note": "none"
    },
    {
      "change": "flip the inverted checks before combining",
      "mechanism": "The same information the inverted checks already carry, read the right way round; a polarity flip keeps their weight instead of discarding it.",
      "calibration_auc": 0.6189718364197532,
      "lower": 0.5349100207071311,
      "upper": 0.7123776259731113,
      "needs_new_calls": false,
      "cost_usd": 0.0,
      "cost_note": "none"
    },
    {
      "change": "drop the flat COCOS check",
      "mechanism": "One check is near-constant across the calibration entries, so it cannot move the mean in either direction and only dilutes the checks that vary.",
      "calibration_auc": 0.6123649691358024,
      "lower": 0.530376547709601,
      "upper": 0.7082546949085061,
      "needs_new_calls": false,
