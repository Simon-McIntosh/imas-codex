{
 "receipt": "JT-60SA EDDB census in the codex graph: FacilitySignal rows for shot E101173 with data class, shot range and a handbook link",
 "consumer": "imas-ambix plan jt60sa-machine-map, gate g-jt60sa-machine-map-1",
 "producer": "imas-codex plan jt60sa-discovery-completion (sections 2 and 3)",
