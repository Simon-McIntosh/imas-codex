 "notes": [
  "Handbook link means a WikiChunk -[:DOCUMENTS]-> FacilitySignal edge; all links come from the jt-60sa:CategoryInformation page, which fronts EDDB and PMDB.",
  "Category is the first segment of data_source_path, falling back to name.",
  "example_shot is stored as the integer 101173 for every jt-60sa signal."
 ],
 "query": "MATCH (s:FacilitySignal {facility_id: 'jt-60sa'})\nWHERE s.example_shot = 101173\nWITH s, split(coalesce(s.data_source_path, s.name), '/')[0] AS category,\n     EXISTS { MATCH (:WikiChunk)-[:DOCUMENTS]->(s) } AS documented\nRETURN category,\n       count(s) AS signals,\n       count(s.data_class) AS with_data_class,\n       count(s.shot_range) AS with_shot_range,\n       sum(CASE WHEN documented THEN 1 ELSE 0 END) AS with_handbook_link,\n       sum(CASE WHEN s.data_class IS NOT NULL AND s.shot_range IS NOT NULL AND documented THEN 1 ELSE 0 END) AS meets_all_three,\n       count(s.pid) AS with_pid\nORDER BY category",
