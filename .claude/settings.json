{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85"
  },
  "permissions": {
    "allow": [
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(eza *)",
      "Bash(tokei *)",
      "Bash(litellm *)",
      "Bash(apptainer --version)",
      "Bash(apptainer pull:*)",
